  "core_principle": {
    "id": "perception_lock",
    "name": "对象认知锁定",
    "rule": "玩家必须选择可见行动目标，但系统不得告知该目标的真实类型。true_entity_kind 属于 gm_hidden_context，只给规则引擎、GM 面板和存档 hidden 字段使用。",
    "player_sees": [
      "visible_name",
      "scene_description",
      "visible_anomaly",
      "confirmed_clues",
      "suspected_rules",
      "action_consequences"
    ],
    "player_must_infer": [
      "source_entity",
      "medium",
      "projection",
      "ghost_slave",
      "phenomenon",
      "unknown"
    ],
    "forbidden_on_player_ui": [
      "true_entity_kind",
      "linked_source_id",
      "hidden_properties",
      "interaction_rules.hidden_outcomes",
      "GM 标签如「源头」「投影」「鬼奴」作为对象类型徽章"
    ]
  },
  "difficulty": {
    "field": "save.difficulty",
    "default": "standard",
    "modes": [
      {
        "id": "easy",
        "label": "低难度",
        "player_hints": true,
        "warn_before_contain_non_source": true,
        "hint_not_necessarily_source": true,
        "fail_reveals": "soft_type_hint",
        "ai_may_say": ["该目标未必是源头", "隔绝后异常没有真正停止"]
      },
      {
        "id": "standard",
        "label": "标准难度",
        "player_hints": false,
        "warn_before_contain_non_source": false,
        "hint_not_necessarily_source": false,
        "fail_reveals": "consequence_plus_clue",
        "ai_may_say": ["只描述现象与部分线索", "不点明对象类型"]
      },
      {
        "id": "hard",
        "label": "高难度",
        "player_hints": false,
        "warn_before_contain_non_source": false,
        "hint_not_necessarily_source": false,
        "fail_reveals": "consequence_only",
        "ai_may_say": ["只描述后果", "不给类型判断，不给关错警告"]
      }
    ]
  },
  "entity_schema": {
    "id": "string",
    "visible_name": "string",
    "visibility": "known|partially_known|hidden",
    "location_id": "string",
    "present": "boolean",
    "player_visible": {
      "appearance": "string",
      "anomaly": "string",
      "last_observed": "string",
      "known_facts": ["string"]
    },
    "player_assessment": {
      "suspected_kind": "source_entity|medium|projection|ghost_slave|phenomenon|unknown|null",
      "note": "string",
      "updated_at": "string"
    },
    "revealed_properties": ["string"],
    "gm_hidden": {
      "true_entity_kind": "source_entity|medium|projection|ghost_slave|phenomenon|unknown",
      "linked_source_id": "string|null",
      "in_reality": "real|partially_real|not_in_reality|unknown",
      "hidden_properties": ["string"],
      "interaction_rules": {
        "observe": { "visible_outcome": "string", "hidden_outcome": "string", "reveal_on": ["string"] },
        "attack": { "visible_outcome": "string", "hidden_outcome": "string", "kills": "never|if_ghost_slave|never_source" },
        "use_power": { "visible_outcome": "string", "hidden_outcome": "string", "mechanism_needed": ["string"] },
        "contain": {
          "if_true_source": "may_attempt_if_reality_and_window_and_gold",
          "if_not_source": "event_not_resolved",
          "visible_outcome_by_difficulty": {
            "easy": "string",
            "standard": "string",
            "hard": "string"
          },
          "hidden_outcome": "string"
        }
      }
    }
  },
